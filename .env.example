# ============================================================
# GREENRAILS — Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.
# ============================================================

# ——————————————————————————————————————
# Public (safe to expose to browser)
# ——————————————————————————————————————
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GREENRAILS
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_GETMONEYNEWS_URL=https://getmoneynews.online

# ——————————————————————————————————————
# Database (Supabase or compatible)
# ——————————————————————————————————————
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ——————————————————————————————————————
# Authentication
# ——————————————————————————————————————
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret

# ——————————————————————————————————————
# Payment Providers (future integration)
# ——————————————————————————————————————
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_ENVIRONMENT=sandbox

PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_key

# ——————————————————————————————————————
# Intelligence Engine
# ——————————————————————————————————————
INTELLIGENCE_API_KEY=your_intelligence_api_key
INTELLIGENCE_FEED_URL=https://api.greenrails.io/intelligence

# ——————————————————————————————————————
# Content / Publishing
# ——————————————————————————————————————
GETMONEYNEWS_API_KEY=your_getmoneynews_api_key
GETMONEYNEWS_PUBLISH_URL=https://getmoneynews.online/api/publish

# ——————————————————————————————————————
# Storage (media assets)
# ——————————————————————————————————————
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=greenrails-media

# ——————————————————————————————————————
# Email
# ——————————————————————————————————————
EMAIL_FROM=noreply@greenrails.io
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_password

# ——————————————————————————————————————
# Monitoring & Logging
# ——————————————————————————————————————
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
LOG_LEVEL=info
